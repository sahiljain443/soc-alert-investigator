# SOC Alert Investigator - Environment Configuration
# Copy this file to .env and fill in your API keys

# VirusTotal API Key
# Get yours at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key
# Get yours at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# IPInfo API Token
# Get yours at: https://ipinfo.io/account/token
IPINFO_API_KEY=

# Spur.us API Key (Residential Proxy/VPN Detection)
# Get yours at: https://spur.us/app/context
SPUR_API_KEY=

# Shodan API Key (Internet-wide Scanning Data)
# Get yours at: https://account.shodan.io/
SHODAN_API_KEY=

# Cisco Talos API Key (IP/Domain Reputation)
# Get yours at: https://talosintelligence.com/
TALOS_API_KEY=

# AlienVault OTX API Key (Open Threat Exchange)
# Get yours at: https://otx.alienvault.com/api
OTX_API_KEY=

# RH-ISAC MISP API Key (Retail & Hospitality ISAC)
# Generate at: https://misp.rhisac.org/users/view/me -> Auth Keys -> Add authentication key
RHISAC_API_KEY=

# DataDog Security Monitoring API
# Required for --datadog mode to fetch SIEM signals
# Get API key at: https://app.datadoghq.com/organization-settings/api-keys
# Get App key at: https://app.datadoghq.com/organization-settings/application-keys
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
